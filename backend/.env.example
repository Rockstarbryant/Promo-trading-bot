# --- Database ---
DATABASE_URL=postgresql+asyncpg://promo_user:promo_pass@localhost:5432/promo_trader
DATABASE_URL_SYNC=postgresql+psycopg2://promo_user:promo_pass@localhost:5432/promo_trader

# --- Binance ---
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# Fernet key used to encrypt stored Binance API secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BINANCE_API_ENCRYPTION_KEY=

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- App ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Global safety switch. Must be explicitly set to "true" for any bot to be
# allowed to submit real orders. Everything defaults to PAPER mode otherwise.
ALLOW_LIVE_TRADING=false
