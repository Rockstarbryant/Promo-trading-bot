# URL the browser uses to reach the backend directly is NOT needed — the
# frontend proxies all API calls through its own Route Handlers so that
# auth tokens never reach client-side JavaScript. Only the server needs to
# know where the backend lives:
BACKEND_API_BASE_URL=https://promo-trading-bot.onrender.com
http://backend:8000

# Set to "production" to mark auth cookies Secure (requires HTTPS).
NODE_ENV=production
development
